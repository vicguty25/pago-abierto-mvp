# ---------------------------------------------------------------------------
# Pago Abierto — variables de entorno
# Copia este archivo a .env.local. Sin credenciales la app arranca igual:
# el proveedor de pagos cae automaticamente a "mock".
# ---------------------------------------------------------------------------

# Postgres. En Supabase usa el "Transaction pooler" (puerto 6543) para
# serverless. postgres.js necesita prepare:false contra el pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# URL publica de la app. La pantalla de consentimiento de Open Payments
# redirige aqui, asi que en produccion debe ser el dominio real (no localhost).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# "testnet" | "mock". Si se deja vacio, o si faltan las credenciales de abajo,
# se usa "mock".
PAYMENT_PROVIDER="mock"

# ---------------------------------------------------------------------------
# Credenciales de la red de pruebas de Interledger
# Se obtienen en https://wallet.interledger-test.dev
#   1. Crear cuenta y fondearla con dinero de juego
#   2. Add wallet address  -> la direccion que COBRA
#   3. Developer Keys -> Generate public & private key
# ---------------------------------------------------------------------------

# Wallet address que recibe los cobros (la del freelancer).
OPEN_PAYMENTS_WALLET_ADDRESS="https://ilp.interledger-test.dev/tu-direccion"

# Key ID mostrado junto a la llave generada.
OPEN_PAYMENTS_KEY_ID=""

# Contenido del private.key en una sola linea, con \n literales.
# Nunca se commitea: .gitignore excluye *.key y .env*
OPEN_PAYMENTS_PRIVATE_KEY=""
